---
import { HOME_GUIDE_GROUPS } from '../lib/homeLinks';
---

<section class="bg-gray-50 border-t border-gray-200" aria-labelledby="home-guides-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
        <h2 id="home-guides-heading" class="text-2xl font-bold text-gray-900 mb-2">Guides and card stacks</h2>
        <p class="text-gray-600 mb-6 max-w-3xl">
            Not sure which category you need? These <a href="/guides/" class="text-red-600 underline underline-offset-2">guides</a>
            explain how to choose, and the <a href="/stacks/" class="text-red-600 underline underline-offset-2">stacks</a> pair
            cards that work well together.
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            {
                HOME_GUIDE_GROUPS.map((group) => (
                    <div>
                        <h3 class="font-semibold text-gray-900 mb-2">{group.heading}</h3>
                        <ul class="space-y-1.5 text-sm">
                            {group.links.map((link) => (
                                <li>
                                    <a href={link.href} class="text-red-600 hover:text-red-700 underline underline-offset-2">
                                        {link.label}
                                    </a>
                                    <span class="text-gray-500"> · {link.note}</span>
                                </li>
                            ))}
                        </ul>
                    </div>
                ))
            }
        </div>
    </div>
</section>
