---
import type { CreditCard } from '../lib/types';
import { getHubBySlug, filterCardsForHub } from '../lib/hubs';
import { HOME_CATEGORY_PICKS } from '../lib/homeLinks';

interface Props {
    cards: CreditCard[];
}

const { cards } = Astro.props;
const bySlug = new Map(cards.map((card) => [card.slug, card]));

const categories = HOME_CATEGORY_PICKS.map((group) => {
    const hub = getHubBySlug(group.hub);
    const inHub = new Set(filterCardsForHub(cards, group.hub).map((card) => card.slug));
    const picks = group.picks.flatMap((pick) => {
        const card = bySlug.get(pick.slug);
        if (!card || !inHub.has(card.slug)) return [];
        if (pick.note.includes('{rate}') && !card.purchaseInterestRateDisplay) return [{ card, note: '' }];
        return [{ card, note: pick.note.replace('{rate}', card.purchaseInterestRateDisplay) }];
    });
    return { hub, heading: group.heading, picks };
});
---

<section class="bg-white border-b border-gray-200" aria-labelledby="home-best-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
        <h2 id="home-best-heading" class="text-2xl font-bold text-gray-900 mb-2">Best credit cards in Canada (2026)</h2>
        <p class="text-gray-600 mb-6 max-w-3xl">
            A starting pick or two in each category. Every list has the full set of cards with current fees, and
            each card page has the full review.
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {
                categories.map(({ hub, heading, picks }) => (
                    <div class="rounded-xl border border-gray-200 p-4">
                        <h3 class="font-semibold text-gray-900 mb-2">
                            <a href={`/best/${hub.slug}/`} class="hover:text-red-600 transition-colors">
                                {heading}
                            </a>
                        </h3>
                        {picks.length > 0 && (
                            <ul class="space-y-1 text-sm text-gray-700 mb-2">
                                {picks.map(({ card, note }) => (
                                    <li>
                                        <a href={`/card/${card.slug}/`} class="text-red-600 hover:text-red-700 underline underline-offset-2">
                                            {card.creditCardName}
                                        </a>
                                        <span class="text-gray-500"> · {card.annualFeeDisplay} fee{note && ` · ${note}`}</span>
                                    </li>
                                ))}
                            </ul>
                        )}
                        <a href={`/best/${hub.slug}/`} class="text-sm font-medium text-gray-700 hover:text-red-600">
                            See all {hub.navLabel} cards →
                        </a>
                    </div>
                ))
            }
        </div>
    </div>
</section>
