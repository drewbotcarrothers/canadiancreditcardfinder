---
import { HUBS } from '../lib/hubs';
import { ISSUER_HUBS } from '../lib/issuers';

const currentYear = new Date().getFullYear();
const linkClass = 'text-gray-600 hover:text-red-600 transition-colors text-sm';
---

<footer class="bg-gray-50 border-t border-gray-200 mt-auto">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-10">
            <div class="min-w-0">
                <div class="flex items-center space-x-3 mb-4">
                    <div class="relative w-10 h-10 shrink-0">
                        <img
                            src="/images/logo.png"
                            alt="Canadian Credit Card Finder Logo"
                            class="absolute inset-0 w-full h-full object-contain"
                        />
                    </div>
                    <h2 class="font-bold text-lg text-gray-900 leading-tight">
                        Canadian Credit Card Finder
                    </h2>
                </div>
                <p class="text-gray-600 text-sm">
                    Helping Canadians find the best credit cards for their needs.
                    Compare rewards, cashback, travel, and low interest cards.
                </p>
            </div>

            <nav class="min-w-0" aria-labelledby="footer-explore-heading">
                <h2 id="footer-explore-heading" class="font-semibold text-gray-900 mb-3">
                    Explore
                </h2>
                <ul class="space-y-2">
                    <li>
                        <a href="/" class={linkClass}>Home</a>
                    </li>
                    <li>
                        <a href="/compare/" class={linkClass}>Compare</a>
                    </li>
                    <li>
                        <a href="/finder/" class={linkClass}>Finder</a>
                    </li>
                    <li>
                        <a href="/guides/" class={linkClass}>Guides</a>
                    </li>
                </ul>
            </nav>

            <nav class="min-w-0" aria-labelledby="footer-best-heading">
                <h2 id="footer-best-heading" class="font-semibold text-gray-900 mb-3">
                    Best of
                </h2>
                <ul class="grid grid-cols-2 gap-x-4 gap-y-2">
                    {HUBS.map((hub) => (
                        <li>
                            <a href={`/best/${hub.slug}/`} class={linkClass}>
                                {hub.navLabel}
                            </a>
                        </li>
                    ))}
                </ul>
            </nav>

            <nav class="min-w-0" aria-labelledby="footer-issuers-heading">
                <h2 id="footer-issuers-heading" class="font-semibold text-gray-900 mb-3">
                    Issuers
                </h2>
                <ul class="grid grid-cols-2 gap-x-4 gap-y-2">
                    {ISSUER_HUBS.map((hub) => (
                        <li class="min-w-0">
                            <a href={`/issuer/${hub.slug}/`} class={linkClass}>
                                {hub.navLabel}
                            </a>
                        </li>
                    ))}
                </ul>
            </nav>
        </div>

        <nav class="mt-10 pt-8 border-t border-gray-200" aria-labelledby="footer-more-tools-heading">
            <h2 id="footer-more-tools-heading" class="font-semibold text-gray-900 mb-2">
                More Canadian tools
            </h2>
            <p class="text-gray-600 text-sm mb-3 max-w-2xl">
                Other free Canadian tools we publish for mortgages, savings, income ideas, and public data.
            </p>
            <ul class="flex flex-wrap gap-x-6 gap-y-2">
                <li>
                    <a href="https://latestmortgagerates.ca/" class={linkClass}>
                        Latest Mortgage Rates
                    </a>
                </li>
                <li>
                    <a href="https://savingoptimizer.com/" class={linkClass}>
                        Saving Optimizer
                    </a>
                </li>
                <li>
                    <a href="https://makemoneyoptimizer.com/" class={linkClass}>
                        Make Money Optimizer
                    </a>
                </li>
                <li>
                    <a href="https://canadiandatainsights.com/" class={linkClass}>
                        Canadian Data Insights
                    </a>
                </li>
            </ul>
        </nav>

        <div class="mt-10 pt-8 border-t border-gray-200 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between lg:gap-8">
            <p class="text-gray-500 text-xs leading-relaxed lg:max-w-3xl">
                <strong>Disclaimer:</strong> Information provided on this website is believed to be accurate
                but is not guaranteed. Please verify all details with the card issuer before applying.
                Credit card offers, terms, and conditions are subject to change without notice.
                We may receive compensation from partners when you apply for credit cards through our links.
            </p>
            <p class="text-gray-500 text-sm lg:text-right lg:shrink-0">
                © {currentYear} Canadian Credit Card Finder. All rights reserved.
            </p>
        </div>
    </div>
</footer>
