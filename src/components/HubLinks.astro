---
import { HUBS, type HubSlug } from '../lib/hubs';
import { ISSUER_HUBS, type IssuerHubSlug } from '../lib/issuers';

interface Props {
    currentSlug?: HubSlug;
    currentIssuerSlug?: IssuerHubSlug;
    showIssuers?: boolean;
}

const { currentSlug, currentIssuerSlug, showIssuers = false } = Astro.props;

const pillClass =
    'inline-flex items-center rounded-full border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:border-red-600 hover:text-red-600 transition-colors';
const activePillClass =
    'inline-flex items-center rounded-full border border-red-600 bg-red-600 px-4 py-2 text-sm font-medium text-white';
---

<nav aria-label="Related pages" class="flex flex-wrap gap-2">
    <a href="/" class={pillClass}>
        All cards
    </a>
    <a href="/compare/" class={pillClass}>
        Compare
    </a>
    {HUBS.map((hub) =>
        hub.slug === currentSlug ? (
            <span class={activePillClass}>{hub.navLabel}</span>
        ) : (
            <a href={`/best/${hub.slug}/`} class={pillClass}>
                {hub.navLabel}
            </a>
        )
    )}
</nav>
{
    showIssuers && (
        <nav aria-label="Browse by issuer" class="flex flex-wrap gap-2 mt-3">
            {ISSUER_HUBS.map((hub) =>
                hub.slug === currentIssuerSlug ? (
                    <span class={activePillClass}>{hub.navLabel}</span>
                ) : (
                    <a href={`/issuer/${hub.slug}/`} class={pillClass}>
                        {hub.navLabel}
                    </a>
                )
            )}
        </nav>
    )
}
