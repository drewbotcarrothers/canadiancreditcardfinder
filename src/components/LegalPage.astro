---
import BaseLayout from '../layouts/BaseLayout.astro';
import { LEGAL_LAST_UPDATED, LEGAL_LAST_UPDATED_ISO } from '../lib/legal';

interface Props {
    title: string;
    heading: string;
    description: string;
    breadcrumb: string;
}

const { title, heading, description, breadcrumb } = Astro.props;
---

<BaseLayout title={title} description={description}>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <nav class="mb-6" aria-label="Breadcrumb">
            <ol class="flex items-center space-x-2 text-sm">
                <li>
                    <a href="/" class="text-gray-500 hover:text-red-600 transition-colors">Home</a>
                </li>
                <li class="text-gray-400">/</li>
                <li class="text-gray-900 font-medium truncate">{breadcrumb}</li>
            </ol>
        </nav>

        <article class="bg-white rounded-xl shadow-md p-6 sm:p-8 legal-content">
            <header class="mb-6">
                <h1 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-3">{heading}</h1>
                <p class="text-sm text-gray-500">
                    Last updated: <time datetime={LEGAL_LAST_UPDATED_ISO}>{LEGAL_LAST_UPDATED}</time>
                </p>
            </header>
            <slot />
        </article>
    </div>
</BaseLayout>

<style is:global>
    .legal-content h2 {
        font-size: 1.25rem;
        line-height: 1.75rem;
        font-weight: 700;
        color: #111827;
        margin-top: 2rem;
        margin-bottom: 0.75rem;
    }
    .legal-content h3 {
        font-size: 1.05rem;
        font-weight: 600;
        color: #111827;
        margin-top: 1.25rem;
        margin-bottom: 0.5rem;
    }
    .legal-content p,
    .legal-content li {
        color: #4b5563;
        line-height: 1.75;
    }
    .legal-content p {
        margin-bottom: 1rem;
    }
    .legal-content ul {
        list-style: disc;
        padding-left: 1.5rem;
        margin-bottom: 1rem;
    }
    .legal-content li {
        margin-bottom: 0.375rem;
    }
    .legal-content a {
        color: #dc2626;
        text-decoration: underline;
        text-underline-offset: 2px;
    }
    .legal-content a:hover {
        color: #b91c1c;
    }
</style>
