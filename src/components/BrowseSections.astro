---
import { HUBS, type HubSlug } from '../lib/hubs';
import { ISSUER_HUBS, type IssuerHubSlug } from '../lib/issuers';

type IconPart =
    | { tag: 'path'; d: string }
    | { tag: 'circle'; cx: number; cy: number; r: number }
    | { tag: 'line'; x1: number; y1: number; x2: number; y2: number }
    | { tag: 'rect'; x: number; y: number; width: number; height: number; rx: number };

// Outline icons adapted from Lucide (ISC). Multiple elements stay as separate
// SVG nodes so shapes are not flattened into a single broken path `d`.
// no-annual-fee uses a "$0" label in the tile — SVG text is unreadable at 20px.
const USE_CASE_ICONS: Record<Exclude<HubSlug, 'no-annual-fee'>, IconPart[]> = {
    travel: [
        {
            tag: 'path',
            d: 'M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z',
        },
    ],
    'cash-back': [
        { tag: 'rect', x: 2, y: 6, width: 20, height: 12, rx: 2 },
        { tag: 'circle', cx: 12, cy: 12, r: 2 },
        { tag: 'path', d: 'M6 12h.01M18 12h.01' },
    ],
    students: [
        {
            tag: 'path',
            d: 'M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z',
        },
        { tag: 'path', d: 'M22 10v6' },
        { tag: 'path', d: 'M6 12.5V16a6 3 0 0 0 12 0v-3.5' },
    ],
    rewards: [
        { tag: 'path', d: 'M12 7v14' },
        { tag: 'path', d: 'M20 11v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-8' },
        { tag: 'path', d: 'M7.5 7a1 1 0 0 1 0-5A4.8 8 0 0 1 12 7a4.8 8 0 0 1 4.5-5 1 1 0 0 1 0 5' },
        { tag: 'rect', x: 3, y: 7, width: 18, height: 4, rx: 1 },
    ],
    groceries: [
        {
            tag: 'path',
            d: 'm2.05 2.05 1.099-.028a1 1 0 0 1 1.008.815l2.69 14.347A1 1 0 0 0 7.83 18H18',
        },
        {
            tag: 'path',
            d: 'M4.563 5h16.435a1 1 0 0 1 .981 1.204l-1.026 6.226A2 2 0 0 1 18.962 14H6.25',
        },
        { tag: 'circle', cx: 18, cy: 20, r: 2 },
        { tag: 'circle', cx: 8, cy: 20, r: 2 },
    ],
    'low-interest': [
        { tag: 'line', x1: 19, y1: 5, x2: 5, y2: 19 },
        { tag: 'circle', cx: 6.5, cy: 6.5, r: 2.5 },
        { tag: 'circle', cx: 17.5, cy: 17.5, r: 2.5 },
    ],
    'us-dollar': [
        { tag: 'circle', cx: 12, cy: 12, r: 10 },
        { tag: 'path', d: 'M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8' },
        { tag: 'path', d: 'M12 18V6' },
    ],
    premium: [
        {
            tag: 'path',
            d: 'M11.562 3.266a.5.5 0 0 1 .876 0L15.39 8.87a1 1 0 0 0 1.516.294L21.183 5.5a.5.5 0 0 1 .798.519l-2.834 10.246a1 1 0 0 1-.956.734H5.81a1 1 0 0 1-.957-.734L2.02 6.02a.5.5 0 0 1 .798-.519l4.276 3.664a1 1 0 0 0 1.516-.294z',
        },
        { tag: 'path', d: 'M5 21h14' },
    ],
};

const ISSUER_BADGES: Record<IssuerHubSlug, { label: string; bg: string }> = {
    'american-express': { label: 'AX', bg: '#006FCF' },
    rbc: { label: 'RBC', bg: '#0051A5' },
    td: { label: 'TD', bg: '#2E8B3A' },
    cibc: { label: 'CIBC', bg: '#C8102E' },
    scotiabank: { label: 'BNS', bg: '#EC111A' },
    bmo: { label: 'BMO', bg: '#0075C9' },
    'rogers-bank': { label: 'RG', bg: '#DA291C' },
    'national-bank': { label: 'NBC', bg: '#B31B34' },
    desjardins: { label: 'DJ', bg: '#00874E' },
    mbna: { label: 'MB', bg: '#9B1B30' },
    tangerine: { label: 'TG', bg: '#FF7200' },
    'simplii-financial': { label: 'SF', bg: '#E31837' },
    'pc-financial': { label: 'PC', bg: '#E87722' },
};
---

<section class="mb-8" aria-labelledby="browse-use-case-heading">
    <h2 id="browse-use-case-heading" class="text-lg font-semibold text-gray-900 mb-4">
        Browse by use case
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-3">
        {
            HUBS.map((hub) => (
                <a
                    href={`/best/${hub.slug}/`}
                    class="group flex items-start gap-3 rounded-xl border border-gray-200 bg-gray-50 p-3.5 hover:border-red-600 hover:bg-white hover:shadow-md transition-all"
                >
                    <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-white border border-gray-200 text-red-600 group-hover:border-red-200 group-hover:bg-red-50 transition-colors">
                        {hub.slug === 'no-annual-fee' ? (
                            <span class="text-[15px] font-bold leading-none tabular-nums tracking-tight" aria-hidden="true">
                                $0
                            </span>
                        ) : (
                            <svg
                                class="h-5 w-5"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.75"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                aria-hidden="true"
                            >
                                {USE_CASE_ICONS[hub.slug].map((part) =>
                                    part.tag === 'path' ? (
                                        <path d={part.d} />
                                    ) : part.tag === 'circle' ? (
                                        <circle cx={part.cx} cy={part.cy} r={part.r} />
                                    ) : part.tag === 'line' ? (
                                        <line x1={part.x1} y1={part.y1} x2={part.x2} y2={part.y2} />
                                    ) : (
                                        <rect
                                            x={part.x}
                                            y={part.y}
                                            width={part.width}
                                            height={part.height}
                                            rx={part.rx}
                                        />
                                    )
                                )}
                            </svg>
                        )}
                    </span>
                    <span class="min-w-0">
                        <span class="block font-semibold text-gray-900 group-hover:text-red-600 transition-colors">
                            {hub.navLabel}
                        </span>
                        <span class="block text-sm text-gray-600 leading-snug">{hub.teaser}</span>
                    </span>
                </a>
            ))
        }
    </div>
</section>

<section class="mb-8" aria-labelledby="browse-issuer-heading">
    <h2 id="browse-issuer-heading" class="text-lg font-semibold text-gray-900 mb-4">
        Browse by issuer
    </h2>
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
        {
            ISSUER_HUBS.map((hub) => {
                const badge = ISSUER_BADGES[hub.slug];
                return (
                    <a
                        href={`/issuer/${hub.slug}/`}
                        class="group flex items-start gap-3 rounded-xl border border-gray-200 bg-white p-3.5 hover:border-red-600 hover:shadow-md transition-all"
                    >
                        <span
                            class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg text-white text-[11px] font-bold tracking-wide"
                            style={`background-color: ${badge.bg}`}
                            aria-hidden="true"
                        >
                            {badge.label}
                        </span>
                        <span class="min-w-0">
                            <span class="block font-semibold text-gray-900 group-hover:text-red-600 transition-colors">
                                {hub.navLabel}
                            </span>
                            <span class="block text-xs text-gray-600 leading-snug line-clamp-2">{hub.teaser}</span>
                        </span>
                    </a>
                );
            })
        }
    </div>
</section>
