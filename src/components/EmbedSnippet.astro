---
/**
 * Copy-paste iframe for a reference page. The credit link text is exactly
 * "Canadian Credit Card Finder" — publishers who paste the snippet keep that wording.
 */
interface Props {
    iframePath: string;
    iframeTitle: string;
    creditPath: string;
    height: number;
}

const { iframePath, iframeTitle, creditPath, height } = Astro.props;
const origin = (Astro.site?.origin ?? 'https://canadiancreditcardfinder.com').replace(/\/$/, '');
const iframeSrc = `${origin}${iframePath}`;
const creditHref = `${origin}${creditPath}`;
const snippet = `<iframe src="${iframeSrc}" title="${iframeTitle}" width="100%" height="${height}" style="border:0;max-width:100%;"></iframe>\n<p>Source: <a href="${creditHref}">Canadian Credit Card Finder</a></p>`;
const snippetId = `embed-snippet-${iframePath.replace(/[^a-z0-9]+/gi, '-')}`;
---

<section class="bg-white rounded-2xl shadow-md p-6 lg:p-8" aria-labelledby={`${snippetId}-heading`}>
    <h2 id={`${snippetId}-heading`} class="text-2xl font-bold text-gray-900 mb-2">Embed this page</h2>
    <p class="text-gray-600 mb-4 max-w-3xl">
        Paste this into another page. The credit link text is Canadian Credit Card Finder.
    </p>
    <label class="sr-only" for={snippetId}>Embed code</label>
    <textarea
        id={snippetId}
        readonly
        rows="5"
        class="w-full rounded-lg border border-gray-300 bg-gray-50 p-3 font-mono text-sm text-gray-800"
    >{snippet}</textarea>
    <button
        type="button"
        class="mt-3 inline-flex items-center rounded-lg bg-red-600 px-4 py-2 font-semibold text-white hover:bg-red-700 transition-colors"
        data-copy-target={snippetId}
    >
        Copy embed code
    </button>
</section>

<script is:inline>
    document.querySelectorAll('[data-copy-target]').forEach(function (button) {
        button.addEventListener('click', function () {
            var id = button.getAttribute('data-copy-target');
            var field = id ? document.getElementById(id) : null;
            if (!field) return;
            var text = field.value;
            var done = function () {
                var original = button.textContent;
                button.textContent = 'Copied';
                setTimeout(function () {
                    button.textContent = original;
                }, 2000);
            };
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(text).then(done);
            } else {
                field.focus();
                field.select();
                document.execCommand('copy');
                done();
            }
        });
    });
</script>
