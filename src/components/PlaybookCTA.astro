---
/**
 * Priced CTA for the paid Playbook. Always place it BELOW affiliate apply buttons and card tables,
 * so it never competes with an issuer application.
 */
import { playbookUrl, checklistUrl, PLAYBOOK_PRICE } from '../lib/playbook';
interface Props {
    placement: string;
    variant?: 'full' | 'compact';
    heading?: string;
}
const { placement, variant = 'full', heading = 'Turn this into your 12-month card plan' } = Astro.props;
const buy = playbookUrl(placement);
const free = checklistUrl(placement);
---
{variant === 'compact' ? (
    <aside class="my-8 rounded-xl border border-gray-200 bg-gray-50 p-5 flex flex-col sm:flex-row sm:items-center gap-4" data-cta="playbook" data-placement={placement}>
        <img src="/images/playbook/playbook-cover.webp" alt="The Canadian Credit Card Playbook 2027 cover" width="72" height="93" loading="lazy" class="w-16 h-auto rounded shadow" />
        <div class="flex-1">
            <p class="font-semibold text-gray-900">The Canadian Credit Card Playbook 2027</p>
            <p class="text-sm text-gray-600">Break-even math on real cards, 10 persona stacks, a 12-month plan and printable worksheets. By Andrew.</p>
        </div>
        <div class="flex flex-col gap-1 sm:items-end">
            <a href={buy} class="inline-block bg-red-600 hover:bg-red-700 text-white py-2 px-5 rounded-lg font-semibold text-sm">Get the Playbook — ${PLAYBOOK_PRICE} CAD</a>
            <a href={free} class="text-xs text-red-600 hover:text-red-700 underline underline-offset-2">Or grab the free Card Fit Checklist</a>
        </div>
    </aside>
) : (
    <section class="my-10 rounded-2xl border-2 border-red-600 bg-white p-6 lg:p-8 grid gap-6 md:grid-cols-[140px_1fr] items-center" data-cta="playbook" data-placement={placement}>
        <img src="/images/playbook/playbook-cover.webp" alt="The Canadian Credit Card Playbook 2027 cover" width="140" height="181" loading="lazy" class="w-28 md:w-full h-auto rounded shadow-md" />
        <div>
            <p class="text-xs font-bold uppercase tracking-widest text-red-600 mb-1">The 2027 edition · PDF + worksheets</p>
            <h2 class="text-2xl font-bold text-gray-900 mb-2">{heading}</h2>
            <p class="text-gray-700 mb-4">The free pages help you understand the options. The Playbook helps you choose: break-even tests on real cards, 10 persona stacks with live fees, a 12-month application plan, approval rules, and a printable Card Fit Workbook.</p>
            <div class="flex flex-wrap items-center gap-4">
                <a href={buy} class="inline-block bg-red-600 hover:bg-red-700 text-white py-3 px-6 rounded-lg font-semibold">Get the Playbook — ${PLAYBOOK_PRICE} CAD</a>
                <a href={free} class="text-red-600 hover:text-red-700 font-medium underline underline-offset-2">Free Card Fit Checklist</a>
            </div>
            <p class="text-xs text-gray-500 mt-3">30-day refund. Educational only, not financial advice.</p>
        </div>
    </section>
)}
