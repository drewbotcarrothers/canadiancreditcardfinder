---
import EmbedLayout from '../../../layouts/EmbedLayout.astro';
import AsOf from '../../../components/AsOf.astro';
import IndexSummary from '../../../components/IndexSummary.astro';
import OfferChangeNote from '../../../components/OfferChangeNote.astro';
import { AUTHOR_NAME, AUTHOR_PATH } from '../../../lib/author';
import { CARD_INDEX_EDITION, CARD_INDEX_PATH, buildCardIndex } from '../../../lib/cardIndex';
import { getCards, getDataFetchedAt } from '../../../lib/data';

const cards = await getCards();
const asOf = getDataFetchedAt();
if (!asOf) throw new Error('Card catalog has no fetch date.');
const index = buildCardIndex(cards, Astro.site ?? 'https://canadiancreditcardfinder.com');
const creditHref = new URL(CARD_INDEX_PATH, Astro.site).href;
const title = `Canadian Credit Card Index, ${CARD_INDEX_EDITION}`;
const description = `Embeddable ${CARD_INDEX_EDITION} summary of ${index.total} Canadian credit cards.`;
---

<EmbedLayout title={title} description={description} canonicalPath={CARD_INDEX_PATH}>
    <h1 class="text-xl font-bold text-gray-900 mb-2">{title}</h1>
    <AsOf date={asOf} class="mb-1" />
    <p class="text-sm text-gray-500 mb-3">
        By <a href={AUTHOR_PATH} rel="author" class="underline underline-offset-2 hover:text-red-600">{AUTHOR_NAME}</a>
    </p>
    <OfferChangeNote class="mb-4" />
    <IndexSummary index={index} breakdown={false} />
    <p class="text-sm text-gray-600 mt-4">
        Source:{' '}
        <a href={creditHref} class="font-medium text-red-600 hover:text-red-700 underline underline-offset-2">
            Canadian Credit Card Finder
        </a>
    </p>
</EmbedLayout>
