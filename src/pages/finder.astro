---
import PlaybookCTA from '../components/PlaybookCTA.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import FinderContent from '../components/FinderContent';
import { getCards } from '../lib/data';

const cards = await getCards();
---

<BaseLayout
    title="Credit Card Finder — Best Card for You (2026) | Canadian Credit Card Finder"
    description="Canadians answer a few questions to get a personalized credit card recommendation."
    noAds
>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <nav class="mb-6" aria-label="Breadcrumb">
            <ol class="flex items-center space-x-2 text-sm">
                <li>
                    <a href="/" class="text-gray-500 hover:text-red-600 transition-colors">
                        Home
                    </a>
                </li>
                <li class="text-gray-400">/</li>
                <li class="text-gray-900 font-medium truncate">Credit Card Finder</li>
            </ol>
        </nav>

        <header class="text-center mb-8">
            <h1 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-4">
                Credit Card Finder
            </h1>
            <p class="text-lg text-gray-600 max-w-2xl mx-auto">
                Answer a few questions and we will narrow our live Canadian card catalog to a top match
                plus a few alternatives. Approval is never guaranteed.
            </p>
            <p class="text-sm text-gray-500 max-w-2xl mx-auto mt-4">
                Prefer a ready-made wallet plan?
                <a href="/stacks/" class="text-red-600 hover:text-red-700 font-medium">Browse credit card stacks by persona</a>.
            </p>
        </header>

        <FinderContent client:load cards={cards} />

        <div class="max-w-3xl mx-auto"><PlaybookCTA placement="finder" heading="Got your match? Build the full 12-month plan" /></div>

        <section class="mt-12 max-w-3xl mx-auto bg-white rounded-2xl shadow-md p-6 lg:p-8 text-gray-700 leading-relaxed space-y-4">
            <h2 class="text-2xl font-bold text-gray-900">How to use the finder</h2>
            <p>
                The finder asks up to five questions, one at a time. First, what you want from a card: cash back,
                travel points, everyday rewards, a student card or a low interest rate. Second, how much you're willing
                to pay each year: $0 only, up to about $150, or a premium fee. If you picked cash back, travel or
                everyday rewards, it then asks where most of your money goes: groceries, gas and transit, dining,
                travel or general spending. Travel answers get one more question about the program you prefer, such as
                Aeroplan, WestJet, hotel points or flexible points. Last, it asks whether you'd like an American Express
                card, one of the Big Five banks, or have no preference.
            </p>
            <h2 class="text-2xl font-bold text-gray-900">How cards are compared</h2>
            <p>
                Every Canadian card on this site goes into the comparison. Your goal and your fee limit work as filters,
                so a $0-only answer leaves paid cards out. Your main spending category is a boost rather than
                a cut: a card that earns more on groceries rises when you pick groceries, but a strong card without that
                category can still appear. For low interest, cards with lower purchase rates rank higher. A listed
                welcome bonus adds a small amount, and student cards are moved down unless you asked for one. If nothing
                matches, the finder relaxes your bank preference first, then the travel program, then the fee limit, and
                tells you which one it dropped.
            </p>
            <p>
                You get one top match and a few alternatives, each with a short reason. Treat them as a shortlist, not
                an approval. Open each card's review to check the income requirement, insurance and current offer, and
                confirm the details on the issuer's site before you apply.
            </p>
        </section>
    </div>
</BaseLayout>
