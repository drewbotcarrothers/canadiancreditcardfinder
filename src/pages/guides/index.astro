---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HubLinks from '../../components/HubLinks.astro';
import { getGuides, guidePath } from '../../lib/guides';

const guides = await getGuides();
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const title = 'Credit Card Guides for Canadians (2026) | Canadian Credit Card Finder';
const description =
    'Practical Canadian credit card guides for 2026: no-fee cards, cash back, travel, groceries, students, USD cards, and bank-by-bank comparisons.';

const jsonLd = {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Credit Card Guides for Canadians',
    description,
    url: canonical,
    mainEntity: {
        '@type': 'ItemList',
        numberOfItems: guides.length,
        itemListElement: guides.map((guide, index) => ({
            '@type': 'ListItem',
            position: index + 1,
            name: guide.data.title,
            url: new URL(guidePath(guide), Astro.site).href,
        })),
    },
};
---

<BaseLayout title={title} description={description}>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <nav class="mb-6" aria-label="Breadcrumb">
            <ol class="flex items-center space-x-2 text-sm">
                <li>
                    <a href="/" class="text-gray-500 hover:text-red-600 transition-colors">Home</a>
                </li>
                <li class="text-gray-400">/</li>
                <li class="text-gray-900 font-medium truncate">Guides</li>
            </ol>
        </nav>

        <header class="mb-8">
            <h1 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-4">
                Credit card guides for Canadians
            </h1>
            <p class="text-lg text-gray-600 max-w-3xl leading-relaxed">
                Decision pieces for Canadian cards billed in CAD (or USD, when that is the point). We link
                live card pages instead of inventing fees and bonuses. Start with a guide, then open the
                matching hub or the finder.
            </p>
        </header>

        <div class="mb-8">
            <HubLinks />
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {
                guides.map((guide) => (
                    <article class="bg-white rounded-xl shadow-md p-6 hover:shadow-lg transition-all card-hover">
                        <h2 class="text-xl font-bold text-gray-900 mb-2">
                            <a href={guidePath(guide)} class="hover:text-red-600 transition-colors">
                                {guide.data.title}
                            </a>
                        </h2>
                        <p class="text-gray-600 leading-relaxed mb-4">{guide.data.excerpt}</p>
                        {
                            guide.data.hubLinks.length > 0 && (
                                <nav
                                    class="flex flex-wrap gap-2 mb-4"
                                    aria-label={`Hubs related to ${guide.data.title}`}
                                >
                                    {guide.data.hubLinks.map((hub) => (
                                        <a
                                            href={hub.href}
                                            class="inline-flex items-center rounded-full border border-gray-300 bg-white px-3 py-1 text-xs font-medium text-gray-700 hover:border-red-600 hover:text-red-600 transition-colors"
                                        >
                                            {hub.label}
                                        </a>
                                    ))}
                                </nav>
                            )
                        }
                        <a
                            href={guidePath(guide)}
                            class="inline-flex items-center font-semibold text-red-600 hover:text-red-700 transition-colors"
                        >
                            Read the guide
                            <span aria-hidden="true" class="ml-1">→</span>
                        </a>
                    </article>
                ))
            }
        </div>

        <section
            class="mt-12 bg-gradient-to-r from-gray-900 to-gray-800 rounded-2xl p-8 lg:p-12 text-center text-white"
        >
            <h2 class="text-2xl lg:text-3xl font-bold mb-4">Not sure which guide applies?</h2>
            <p class="text-gray-300 mb-6 max-w-2xl mx-auto">
                Answer a few questions and we will narrow the live Canadian catalog to a top match plus
                alternatives.
            </p>
            <a
                href="/finder/"
                class="inline-block bg-red-600 hover:bg-red-700 text-white py-3 px-8 rounded-lg font-semibold transition-colors"
            >
                Open the finder
            </a>
        </section>

        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    </div>
</BaseLayout>
