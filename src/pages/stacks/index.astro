---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HubLinks from '../../components/HubLinks.astro';
import { getStackPersonas, STACK_DISCLAIMER, stackPath } from '../../lib/stacks';

const personas = getStackPersonas();
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const title = 'Canadian Credit Card Stacks by Persona (2026) | Canadian Credit Card Finder';
const description =
    'Ten Canadian credit card stacks by goal: cash back, groceries and Costco, travel points, newcomers, no-FX, premium perks, and more. Built from our live card catalog.';

const jsonLd = {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Canadian Credit Card Stacks by Persona',
    description,
    url: canonical,
    mainEntity: {
        '@type': 'ItemList',
        numberOfItems: personas.length,
        itemListElement: personas.map((persona, index) => ({
            '@type': 'ListItem',
            position: index + 1,
            name: persona.name,
            url: new URL(stackPath(persona.slug), Astro.site).href,
            description: persona.shortWho,
        })),
    },
};

const breadcrumbJsonLd = {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
        {
            '@type': 'ListItem',
            position: 1,
            name: 'Home',
            item: new URL('/', Astro.site).href,
        },
        {
            '@type': 'ListItem',
            position: 2,
            name: 'Stacks',
            item: canonical,
        },
    ],
};
---

<BaseLayout title={title} description={description}>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <nav class="mb-6" aria-label="Breadcrumb">
            <ol class="flex items-center space-x-2 text-sm">
                <li>
                    <a href="/" class="text-gray-500 hover:text-red-600 transition-colors">Home</a>
                </li>
                <li class="text-gray-400">/</li>
                <li class="text-gray-900 font-medium truncate">Stacks</li>
            </ol>
        </nav>

        <header class="mb-8 max-w-3xl">
            <h1 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-4">
                Canadian credit card stacks by persona
            </h1>
            <p class="text-lg text-gray-600 leading-relaxed mb-4">
                A stack is a small set of cards with clear jobs — grocery earner, catch-all, no-foreign-fee
                travel card — instead of hunting for one “best” card. These ten personas group Canadians by
                what they want back: cash, points, acceptance at Costco, lounges, or a first card.
            </p>
            <p class="text-gray-600 leading-relaxed">
                Pay every balance in full. Fees and earn rates on each stack page come from our live catalog —
                open the card review before you apply. Written by Andrew for Canadian Credit Card Finder.
            </p>
        </header>

        <div class="mb-8">
            <HubLinks />
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
            {
                personas.map((persona) => (
                    <article class="bg-white rounded-xl shadow-md p-6 hover:shadow-lg transition-all card-hover flex flex-col">
                        <p class="text-xs font-semibold uppercase tracking-wide text-red-700 mb-2">
                            {persona.complexity}
                        </p>
                        <h2 class="text-xl font-bold text-gray-900 mb-2">
                            <a
                                href={stackPath(persona.slug)}
                                class="hover:text-red-600 transition-colors"
                            >
                                {persona.name}
                            </a>
                        </h2>
                        <p class="text-gray-600 leading-relaxed mb-3">{persona.shortWho}</p>
                        <p class="text-sm text-gray-700 leading-relaxed mb-4 flex-1">
                            <span class="font-semibold text-gray-900">Stack: </span>
                            {persona.stackSummary}
                        </p>
                        <a
                            href={stackPath(persona.slug)}
                            class="inline-flex items-center font-semibold text-red-600 hover:text-red-700 transition-colors"
                        >
                            Open this stack
                            <span aria-hidden="true" class="ml-1">
                                →
                            </span>
                        </a>
                    </article>
                ))
            }
        </div>

        <section
            class="bg-gradient-to-r from-gray-900 to-gray-800 rounded-2xl p-8 lg:p-12 text-center text-white mb-10"
        >
            <h2 class="text-2xl lg:text-3xl font-bold mb-4">Not sure which persona fits?</h2>
            <p class="text-gray-300 mb-6 max-w-2xl mx-auto">
                Answer a few questions in the finder and we will narrow the live Canadian catalog to a top
                match plus alternatives. Then come back to the matching stack for the full wallet plan.
            </p>
            <a
                href="/finder/"
                class="inline-block bg-red-600 hover:bg-red-700 text-white py-3 px-8 rounded-lg font-semibold transition-colors"
            >
                Open the finder
            </a>
        </section>

        <aside class="bg-gray-50 border border-gray-200 rounded-xl p-5 mb-10">
            <p class="text-sm text-gray-600 leading-relaxed">
                <strong class="text-gray-800">Disclaimer:</strong>
                {STACK_DISCLAIMER}
            </p>
        </aside>

        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
        <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
    </div>
</BaseLayout>
