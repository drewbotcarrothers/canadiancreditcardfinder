---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CardGrid from '../../components/CardGrid';
import HubLinks from '../../components/HubLinks.astro';
import RelatedGuide from '../../components/RelatedGuide.astro';
import { getCardsForIssuerHub } from '../../lib/data';
import { getRelatedGuidesForIssuer } from '../../lib/guides';
import { getIssuerHubBySlug, getIssuerHubSlugs, isIssuerHubSlug } from '../../lib/issuers';

export async function getStaticPaths() {
    return getIssuerHubSlugs().map((issuer) => ({
        params: { issuer },
    }));
}

const { issuer } = Astro.params;

if (!issuer || !isIssuerHubSlug(issuer)) {
    throw new Error(`Unknown issuer hub: ${issuer ?? '(missing)'}`);
}

const hub = getIssuerHubBySlug(issuer);
const hubCards = await getCardsForIssuerHub(issuer);
const relatedGuides = await getRelatedGuidesForIssuer(issuer);
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const jsonLd = {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: hub.h1,
    description: hub.description,
    url: canonical,
    mainEntity: {
        '@type': 'ItemList',
        numberOfItems: hubCards.length,
        itemListElement: hubCards.map((card, index) => ({
            '@type': 'ListItem',
            position: index + 1,
            name: card.creditCardName,
            url: new URL(`/card/${card.slug}/`, Astro.site).href,
        })),
    },
};
---

<BaseLayout title={hub.title} description={hub.description}>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <nav class="mb-6" aria-label="Breadcrumb">
            <ol class="flex items-center space-x-2 text-sm">
                <li>
                    <a href="/" class="text-gray-500 hover:text-red-600 transition-colors">
                        Home
                    </a>
                </li>
                <li class="text-gray-400">/</li>
                <li class="text-gray-900 font-medium truncate">{hub.h1}</li>
            </ol>
        </nav>

        <header class="mb-8">
            <h1 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-4">
                {hub.h1}
            </h1>
            <p class="text-lg text-gray-600 max-w-3xl leading-relaxed">
                {hub.intro}
            </p>
        </header>

        <RelatedGuide guides={relatedGuides} />

        <div class="mb-8">
            <HubLinks currentIssuerSlug={hub.slug} showIssuers />
        </div>

        <div class="bg-white rounded-xl shadow-md p-4 mb-6">
            <p class="text-gray-600">
                Showing <span class="font-semibold text-gray-900">{hubCards.length}</span> cards
            </p>
        </div>

        <CardGrid client:load cards={hubCards} />

        <section class="mt-12 bg-gradient-to-r from-gray-900 to-gray-800 rounded-2xl p-8 lg:p-12 text-center text-white">
            <h2 class="text-2xl lg:text-3xl font-bold mb-4">
                Compare cards side by side
            </h2>
            <p class="text-gray-300 mb-6 max-w-2xl mx-auto">
                Add up to three cards from this list, then open Compare to review fees, rates, and rewards together.
            </p>
            <a
                href="/compare/"
                class="inline-block bg-red-600 hover:bg-red-700 text-white py-3 px-8 rounded-lg font-semibold transition-colors"
            >
                Go to Compare
            </a>
        </section>

        <section class="mt-10">
            <h2 class="text-lg font-semibold text-gray-900 mb-4">More ways to browse</h2>
            <HubLinks currentIssuerSlug={hub.slug} showIssuers />
        </section>

        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    </div>
</BaseLayout>
