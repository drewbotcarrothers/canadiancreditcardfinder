---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeContent from '../components/HomeContent';
import {
    getCards,
    getUniqueCategories,
    getUniqueIssuers,
    getUniqueRewardsPrograms,
} from '../lib/data';
import { toHomepageCard } from '../lib/homepage';
import BrowseSections from '../components/BrowseSections.astro';
import HomeLinkSections from '../components/HomeLinkSections.astro';
import HomeGuideLinks from '../components/HomeGuideLinks.astro';
import { CONTACT_EMAIL } from '../lib/legal';

const [allCards, categories, issuers, rewardsPrograms] = await Promise.all([
    getCards(),
    getUniqueCategories(),
    getUniqueIssuers(),
    getUniqueRewardsPrograms(),
]);
const cards = allCards.map(toHomepageCard);
const siteUrl = new URL('/', Astro.site).href;
const siteJsonLd = [
    {
        '@context': 'https://schema.org',
        '@type': 'Organization',
        '@id': `${siteUrl}#organization`,
        name: 'Canadian Credit Card Finder',
        url: siteUrl,
        email: CONTACT_EMAIL,
        contactPoint: {
            '@type': 'ContactPoint',
            contactType: 'customer support',
            email: CONTACT_EMAIL,
            url: new URL('/contact/', Astro.site).href,
            areaServed: 'CA',
            availableLanguage: 'en',
        },
        publishingPrinciples: new URL('/editorial-policy/', Astro.site).href,
        logo: {
            '@type': 'ImageObject',
            url: new URL('/images/logo-512.png', Astro.site).href,
            width: 512,
            height: 512,
        },
    },
    {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        '@id': `${siteUrl}#website`,
        name: 'Canadian Credit Card Finder',
        url: siteUrl,
        inLanguage: 'en-CA',
        publisher: { '@id': `${siteUrl}#organization` },
    },
];
---

<BaseLayout
    title="Compare Credit Cards in Canada (2026) | Credit Card Finder"
    description="Compare credit cards in Canada side by side. Use our free credit card finder to filter cash back, travel, rewards, no fee and low interest cards for 2026."
>
    <script type="application/ld+json" set:html={JSON.stringify(siteJsonLd)} />
    <section class="bg-gradient-to-br from-gray-900 to-gray-800 text-white py-16">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold mb-4">
                Compare Credit Cards in Canada
            </h1>
            <p class="text-lg sm:text-xl text-gray-300 max-w-2xl mx-auto">
                Use our credit card finder to compare Canadian credit cards and find your match.
                Filter by rewards, cashback, travel perks, and more.
            </p>
            <a
                href="/finder/"
                class="inline-block mt-8 bg-red-600 hover:bg-red-700 text-white py-3 px-8 rounded-lg font-semibold transition-colors"
            >
                Find my card
            </a>
        </div>
    </section>

    <HomeLinkSections cards={allCards} />

    <HomeContent
        client:load
        cards={cards}
        categories={categories}
        issuers={issuers}
        rewardsPrograms={rewardsPrograms}
    >
        <BrowseSections />
    </HomeContent>

    <HomeGuideLinks />
</BaseLayout>
