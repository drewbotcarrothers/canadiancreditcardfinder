---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AddToCompareButton from '../../components/AddToCompareButton';
import CardGrid from '../../components/CardGrid';
import { cardImageSrc, PLACEHOLDER_IMAGE_SRC } from '../../lib/cardImage';
import { getCards, getRelatedCards } from '../../lib/data';
import { getIssuerHubForName } from '../../lib/issuers';
import type { CreditCard } from '../../lib/types';

export async function getStaticPaths() {
    const cards = await getCards();
    return cards.map((card) => ({
        params: { slug: card.slug },
        props: { card },
    }));
}

interface Props {
    card: CreditCard;
}

const { card } = Astro.props;
const relatedCards = await getRelatedCards(card, 3);
const issuerHub = getIssuerHubForName(card.issuer);
const imageSrc = cardImageSrc(card.imageFile);
const title = `${card.creditCardName} | ${card.issuer} | Canadian Credit Card Finder`;
const description = `${card.creditCardName} from ${card.issuer}. Annual fee: ${card.annualFeeDisplay}. Interest: ${card.purchaseInterestRateDisplay}. ${card.welcomeBonus}. Compare and apply at Canadian Credit Card Finder.`;
const jsonLd = {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: card.creditCardName,
    brand: {
        '@type': 'Brand',
        name: card.issuer,
    },
    category: 'Credit Card',
    offers: {
        '@type': 'Offer',
        price: card.annualFee.toString(),
        priceCurrency: 'CAD',
    },
};
---

<BaseLayout title={title} description={description}>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <nav class="mb-6">
            <ol class="flex items-center space-x-2 text-sm">
                <li>
                    <a href="/" class="text-gray-500 hover:text-red-600 transition-colors">
                        Home
                    </a>
                </li>
                {issuerHub && (
                    <li class="text-gray-400">/</li>
                )}
                {issuerHub && (
                    <li>
                        <a
                            href={`/issuer/${issuerHub.slug}/`}
                            class="text-gray-500 hover:text-red-600 transition-colors"
                        >
                            {issuerHub.navLabel}
                        </a>
                    </li>
                )}
                <li class="text-gray-400">/</li>
                <li class="text-gray-900 font-medium truncate">{card.creditCardName}</li>
            </ol>
        </nav>

        <section class="bg-white rounded-2xl shadow-lg p-6 lg:p-10 mb-8">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
                <div class="relative bg-gradient-to-br from-gray-100 to-gray-50 rounded-xl flex items-center justify-center p-8">
                    <div class="relative w-full max-w-md aspect-[1.586/1]">
                        <img
                            src={imageSrc}
                            alt={`${card.creditCardName} credit card`}
                            class="absolute inset-0 w-full h-full object-contain"
                            onerror={`this.onerror=null;this.src='${PLACEHOLDER_IMAGE_SRC}'`}
                        />
                    </div>
                </div>

                <div>
                    <span class="inline-block bg-gray-100 text-gray-700 text-sm font-medium px-4 py-1.5 rounded-full mb-4">
                        {card.category}
                    </span>
                    <h1 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-2">
                        {card.creditCardName}
                    </h1>
                    <p class="text-lg text-gray-600 mb-6">
                        {issuerHub ? (
                            <>
                                by{' '}
                                <a
                                    href={`/issuer/${issuerHub.slug}/`}
                                    class="hover:text-red-600 transition-colors"
                                >
                                    {card.issuer}
                                </a>
                            </>
                        ) : (
                            <>by {card.issuer}</>
                        )}
                    </p>

                    <div class="flex flex-col sm:flex-row gap-4">
                        <a
                            href={card.productLink}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="bg-red-600 hover:bg-red-700 text-white text-center py-3 px-8 rounded-lg font-semibold transition-colors text-lg"
                        >
                            Apply Now
                        </a>
                        <AddToCompareButton client:load slug={card.slug} />
                    </div>
                </div>
            </div>
        </section>

        <section class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
            <div class="bg-white rounded-xl shadow-md p-5">
                <p class="text-gray-500 text-sm mb-1">Annual Fee</p>
                <p class="text-xl font-bold text-gray-900">{card.annualFeeDisplay}</p>
            </div>
            <div class="bg-white rounded-xl shadow-md p-5">
                <p class="text-gray-500 text-sm mb-1">Purchase Rate</p>
                <p class="text-xl font-bold text-gray-900">{card.purchaseInterestRateDisplay}</p>
            </div>
            <div class="bg-white rounded-xl shadow-md p-5">
                <p class="text-gray-500 text-sm mb-1">Cash Advance Rate</p>
                <p class="text-xl font-bold text-gray-900">{card.cashAdvanceInterestRateDisplay}</p>
            </div>
            <div class="bg-white rounded-xl shadow-md p-5">
                <p class="text-gray-500 text-sm mb-1">Rewards Program</p>
                <p class="text-xl font-bold text-gray-900 truncate">{card.rewardsProgram || 'N/A'}</p>
            </div>
        </section>

        {card.welcomeBonus && (
            <section class="bg-gradient-to-r from-red-50 to-orange-50 rounded-2xl p-6 lg:p-8 mb-8 border border-red-100">
                <h2 class="text-2xl font-bold text-gray-900 mb-4 flex items-center">
                    <span class="w-8 h-8 bg-red-600 rounded-lg flex items-center justify-center mr-3">
                        <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M5 5a3 3 0 015-2.236A3 3 0 0114.83 6H16a2 2 0 110 4h-5V9a1 1 0 10-2 0v1H4a2 2 0 110-4h1.17C5.06 5.687 5 5.35 5 5zm4 1V5a1 1 0 10-1 1h1zm3 0a1 1 0 10-1-1v1h1z"></path>
                            <path d="M9 11H3v5a2 2 0 002 2h4v-7zM11 18h4a2 2 0 002-2v-5h-6v7z"></path>
                        </svg>
                    </span>
                    Welcome Bonus
                </h2>

                {card.welcomeBonusValue && (
                    <p class="text-lg font-semibold text-red-600 mb-3">
                        Estimated Value: {card.welcomeBonusValue}
                    </p>
                )}

                <p class="text-gray-700 mb-4">{card.welcomeBonus}</p>

                {card.welcomeBonusDetailed && (
                    <div class="bg-white/60 rounded-lg p-4 mb-4">
                        <p class="text-sm text-gray-600 preserve-whitespace">{card.welcomeBonusDetailed}</p>
                    </div>
                )}

                {card.welcomeBonusEligibility && (
                    <div class="text-sm text-gray-500">
                        <strong>Eligibility:</strong> {card.welcomeBonusEligibility}
                    </div>
                )}
            </section>
        )}

        <section class="bg-white rounded-2xl shadow-md p-6 lg:p-8 mb-8">
            <h2 class="text-2xl font-bold text-gray-900 mb-6">Fees & Interest Rates</h2>
            <div class="divide-y divide-gray-100">
                <div class="py-4 flex justify-between items-start">
                    <div>
                        <p class="font-medium text-gray-900">Annual Fee</p>
                        {card.annualFeeDetail && (
                            <p class="text-sm text-gray-500 mt-1">{card.annualFeeDetail}</p>
                        )}
                    </div>
                    <p class="font-semibold text-gray-900">{card.annualFeeDisplay}</p>
                </div>
                <div class="py-4 flex justify-between items-start">
                    <div>
                        <p class="font-medium text-gray-900">Additional Card Fee</p>
                        {card.additionalCardDetail && (
                            <p class="text-sm text-gray-500 mt-1">{card.additionalCardDetail}</p>
                        )}
                    </div>
                    <p class="font-semibold text-gray-900">{card.additionalCardFeeDisplay}</p>
                </div>
                <div class="py-4 flex justify-between">
                    <p class="font-medium text-gray-900">Purchase Interest Rate</p>
                    <p class="font-semibold text-gray-900">{card.purchaseInterestRateDisplay}</p>
                </div>
                <div class="py-4 flex justify-between">
                    <p class="font-medium text-gray-900">Cash Advance Interest Rate</p>
                    <p class="font-semibold text-gray-900">{card.cashAdvanceInterestRateDisplay}</p>
                </div>
            </div>
        </section>

        {(card.rewardsProgram || card.features || card.featuresDetailed) && (
            <section class="bg-white rounded-2xl shadow-md p-6 lg:p-8 mb-8">
                <h2 class="text-2xl font-bold text-gray-900 mb-6">Rewards & Features</h2>

                {card.rewardsProgram && (
                    <div class="mb-6">
                        <h3 class="font-bold text-gray-900 mb-2">Rewards Program</h3>
                        <p class="text-gray-700 bg-gray-50 p-4 rounded-lg border border-gray-100">
                            {card.rewardsProgram}
                        </p>
                    </div>
                )}

                {card.features && (
                    <div class="mb-6">
                        <h3 class="font-bold text-gray-900 mb-2">Key Highlights</h3>
                        <div class="text-gray-700 prose prose-sm max-w-none">
                            <p>{card.features}</p>
                        </div>
                    </div>
                )}

                {card.featuresDetailed && (
                    <div>
                        <h3 class="font-bold text-gray-900 mb-2">Detailed Benefits</h3>
                        <div class="bg-gray-50 rounded-lg p-6 border border-gray-100">
                            <p class="text-sm text-gray-600 preserve-whitespace whitespace-pre-wrap leading-relaxed">
                                {card.featuresDetailed}
                            </p>
                        </div>
                    </div>
                )}
            </section>
        )}

        {card.insurance && (
            <section class="bg-white rounded-2xl shadow-md p-6 lg:p-8 mb-8">
                <h2 class="text-2xl font-bold text-gray-900 mb-6 flex items-center">
                    <span class="w-8 h-8 bg-blue-100 text-blue-600 rounded-lg flex items-center justify-center mr-3">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                        </svg>
                    </span>
                    Insurance Coverage
                </h2>
                <div class="bg-blue-50/50 rounded-xl p-6 border border-blue-100">
                    <p class="text-gray-700 preserve-whitespace whitespace-pre-wrap leading-relaxed">
                        {card.insurance}
                    </p>
                </div>
            </section>
        )}

        {card.cardEligibility && (
            <section class="bg-white rounded-2xl shadow-md p-6 lg:p-8 mb-8">
                <h2 class="text-2xl font-bold text-gray-900 mb-6 flex items-center">
                    <span class="w-8 h-8 bg-green-100 text-green-600 rounded-lg flex items-center justify-center mr-3">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path>
                        </svg>
                    </span>
                    Eligibility Requirements
                </h2>
                <div class="bg-green-50/50 rounded-xl p-6 border border-green-100">
                    <p class="text-gray-700 preserve-whitespace whitespace-pre-wrap leading-relaxed">
                        {card.cardEligibility}
                    </p>
                </div>
            </section>
        )}

        <section class="bg-gradient-to-r from-gray-900 to-gray-800 rounded-2xl p-8 lg:p-12 text-center text-white mb-8">
            <h2 class="text-2xl lg:text-3xl font-bold mb-4">
                Ready to apply for {card.creditCardName}?
            </h2>
            <p class="text-gray-300 mb-6 max-w-2xl mx-auto">
                Apply directly through {card.issuer}'s secure application portal.
            </p>
            <a
                href={card.productLink}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-block bg-red-600 hover:bg-red-700 text-white py-4 px-10 rounded-lg font-semibold transition-colors text-lg"
            >
                Apply Now
            </a>
        </section>

        {relatedCards.length > 0 && (
            <section>
                <h2 class="text-2xl font-bold text-gray-900 mb-6">You Might Also Like</h2>
                <CardGrid client:load cards={relatedCards} />
            </section>
        )}

        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    </div>
</BaseLayout>
